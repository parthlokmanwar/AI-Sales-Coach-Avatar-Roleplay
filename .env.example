# ============================================================================
#  HDFC RAG — environment configuration
# ============================================================================
#
# Copy this file to `.env` and fill in the values you need.
# Keys are grouped by REQUIRED / RECOMMENDED / OPTIONAL.
#
# Minimum viable setup: just set VITE_DEEPGRAM_API_KEY + have Ollama running.
# Everything else has a working fallback or is purely optional.
# ============================================================================


# ── REQUIRED ────────────────────────────────────────────────────────────────
#
# Deepgram is the primary speech-to-text engine. The Live Assistant won't
# transcribe customer audio without it. Free tier gives ~$200/mo of credit
# which is plenty for low-volume use.
# Get a key: https://console.deepgram.com/signup
#
VITE_DEEPGRAM_API_KEY=your_deepgram_api_key_here


# ── LLM BACKEND — OpenRouter (default) or local Ollama ──────────────────────
#
# All pitch + chat + calc calls route through core/llm.py.
# LLM_PROVIDER=openrouter uses OpenRouter for all LLM calls (default).
# LLM_PROVIDER=ollama falls back to local Ollama (no API key needed).
#
# Get an OpenRouter key: https://openrouter.ai/keys
#
OPENROUTER_API_KEY=sk-or-v1-...
LLM_PROVIDER=openrouter

# Model selection — change to any OpenRouter model slug.
# Defaults shown below; omit these lines to use the defaults.
# PITCH_MODEL=openai/gpt-4o
# CHAT_MODEL=openai/gpt-4o-mini
# CALC_MODEL=openai/gpt-4o-mini

# Ollama model names — used only when LLM_PROVIDER=ollama.
# OLLAMA_PITCH_MODEL=qwen2.5:14b
# OLLAMA_CHAT_MODEL=llama3.1:8b
# OLLAMA_CALC_MODEL=qwen2.5:14b



# ── RECOMMENDED ─────────────────────────────────────────────────────────────
#
# Backend port + frontend proxy target. Defaults match each other; only
# override if 8003 is in use by something else on your machine.
#
PORT=8003
VITE_API_URL=http://127.0.0.1:8003


# ── OPTIONAL — HAS FALLBACK ─────────────────────────────────────────────────
#
# SARVAM AI   — better Hindi/Hinglish STT accuracy than Deepgram. ONLY used
#               on chunks where language is detected as Hindi. If unset or
#               the call fails, Deepgram's Hindi result is used instead.
#               Set VITE_USE_SARVAM=false to skip the Sarvam call entirely
#               (saves one network call per Hindi chunk).
# VITE_SARVAM_API_KEY=
# VITE_USE_SARVAM=true


# ── OPTIONAL — VOICE FINGERPRINT TUNING ─────────────────────────────────────
#
# Backend for the "Auto Speaker Filter" mode's voiceprint engine.
# Pick based on what's installed and how much accuracy you need:
#
#   mfcc        — librosa+numpy. No extra deps. ~70% accuracy. Fast (~30 ms).
#   resemblyzer — `pip install resemblyzer`. ~85% accuracy. 256-dim. (webrtcvad
#                 requires Python <= 3.12 + MSVC on Windows.)
#   pyannote    — `pip install pyannote.audio` + HF_TOKEN. ~88-90% accuracy.
#                 512-dim. ~150 ms / chunk on CPU.
#   speechbrain — Same ECAPA-TDNN architecture as TitaNet. ~93-95% accuracy.
#                 192-dim, ~1.5% EER. ~30-60 ms on CPU, ~5-10 ms on CUDA.
#                 NO separate install — rides in as a pyannote 3.x dep.
#   titanet     — `pip install nemo_toolkit[asr]`. ~93% accuracy. 192-dim.
#                 0.68% EER. Language-independent (best for Hindi/Hinglish).
#                 ~8 ms / chunk on CUDA GPU, ~50-80 ms on CPU.
#                 (NeMo install requires MSVC on Windows + Python <=3.12.)
#
# VOICEPRINT_BACKEND=speechbrain
#
# Cosine similarity threshold above which a chunk is treated as the agent
# (and skipped). Higher = stricter. Defaults per backend:
#   mfcc=0.88, resemblyzer=0.75, pyannote=0.80, titanet=0.75.
# Override only if you see false positives (agent not being skipped) or
# false negatives (customer being skipped). speechbrain default also 0.75.
# VOICEPRINT_THRESHOLD=0.75
#
# HuggingFace token (needed for pyannote backend, NOT needed for titanet).
# Accept the license at https://huggingface.co/pyannote/embedding first.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx


# ── OPTIONAL — LOCAL WHISPER (Deepgram fallback) ────────────────────────────
#
# faster-whisper runs on the backend and is called when Deepgram fails.
# First call downloads the model (~800MB for large-v3-turbo).
# Defaults below assume an NVIDIA GPU with >=4GB VRAM. On CPU-only machines,
# override WHISPER_DEVICE=cpu and WHISPER_MODEL_SIZE=small for usable latency.
#
WHISPER_MODEL_SIZE=large-v3-turbo  # tiny | base | small | medium | large-v3-turbo
# WHISPER_LIVE_MODEL_SIZE=small    # Model used ONLY for the real-time two-speaker live path.
#                                  # Defaults to "small" (~244MB) — minimum for reliable Hindi/Marathi.
#                                  # Use large-v3-turbo on GPU for best multilingual quality.
#                                  # Use tiny only if CPU latency is the hard constraint.
#                                  # PTT push-to-talk still uses WHISPER_MODEL_SIZE (large-v3-turbo).
WHISPER_DEVICE=cuda                # cuda | cpu (auto-falls back to cpu if no GPU)
WHISPER_COMPUTE_TYPE=int8          # int8 | int8_float16 | float16 | float32
WHISPER_LANGUAGE=auto              # auto | en | hi (forcing speeds up + improves accuracy)


# ── CALL ASSISTANT (Exotel real-time co-pilot) ───────────────────────────────
#
# The Call Assistant streams live Exotel call audio through Whisper STT,
# runs RAG retrieval against loaded HDFC documents, and pushes short grounded
# suggestions to the agent's screen — all in real time, no TTS.
#
# Exotel Stream Applet → WS /ws/exotel/{call_sid}   (audio in)
# Agent browser        ← WS /ws/call-assist/{call_sid} (suggestions out)
#
# CALL_ASSIST_MODEL    — Ollama model used for suggestion generation.
#                        Default: qwen2.5:14b (same quality tier as pitch).
#                        Use llama3.1:8b for faster but slightly shorter replies.
# CALL_ASSIST_RAG_TOP_K — how many RAG chunks to retrieve per utterance (default 4)
#
# CALL_ASSIST_MODEL=qwen2.5:14b
# CALL_ASSIST_RAG_TOP_K=4

# ── VAD tuning (Exotel call audio, 8 kHz μ-law) ─────────────────────────────
#
# Defaults are tuned for typical Indian mobile phone call quality.
# Raise VAD_SPEECH_RMS if background noise triggers false utterances.
# Raise VAD_TRAILING_SILENCE_MS if the model cuts off mid-sentence.
#
# VAD_SPEECH_RMS=400           # RMS amplitude to start an utterance
# VAD_SILENCE_RMS=250          # RMS amplitude to count as silence
# VAD_TRAILING_SILENCE_MS=300  # ms of silence before emitting utterance
# VAD_PRE_SPEECH_CHUNKS=2      # consecutive speech chunks to confirm speech start
# VAD_MAX_DURATION_S=12.0      # hard cap — emit even if no silence detected
# VAD_MIN_DURATION_S=0.4       # discard utterances shorter than this


# ── CALL ASSISTANT V2 (Twilio real-time copilot) ─────────────────────────────
#
# V2 places an OUTBOUND Twilio call to the AGENT's phone; when answered, Twilio
# bridges the customer (<Dial>) and forks both audio tracks to our backend via
# <Start><Stream>. The customer track is transcribed (local faster-whisper),
# grounded against loaded HDFC docs (RAG), and a streamed suggestion is pushed
# to the agent's browser. The agent reads it and speaks — copilot, not a bot.
#
#   Twilio media fork → WS /ws/call-assistant-v2/twilio/{call_id}  (audio in)
#   Agent browser     ← WS /ws/call-assistant-v2/agent/{call_id}   (suggestions)
#
# REQUIRED for live calls (everything else has a working default):
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx          # your Twilio caller-ID number
AGENT_PHONE_NUMBER=+91xxxxxxxxxx          # default agent phone (overridable per call)
#
# PUBLIC_BASE_URL — the PUBLIC https host of THIS backend (e.g. an ngrok/cloudflared
# tunnel from start-tunnels.ps1). Twilio fetches TwiML and opens the media WS here,
# so it must be reachable from the internet. No trailing slash.
PUBLIC_BASE_URL=https://your-tunnel-host.example.com
#
# ── V2 tuning (optional) ─────────────────────────────────────────────────────
# CALL_ASSIST_V2_CUSTOMER_TRACK=outbound   # which forked track is the customer.
#                                          # On a Stream attached to the agent leg,
#                                          # outbound = customer (Dial), inbound = agent.
# CALL_ASSIST_V2_MODEL=gpt-4o-mini         # OpenRouter model for the suggestion
# CALL_ASSIST_V2_RAG_TOP_K=4               # RAG chunks retrieved per customer utterance
# CALL_ASSIST_V2_TRANSCRIBE_AGENT=true     # also transcribe the agent track (reference only)
# TWILIO_VALIDATE_SIGNATURE=false          # enforce X-Twilio-Signature on webhooks


# ── ROLEPLAY SIMULATION (Tavus Avatar Training) ──────────────────────────────
#
# Powers the RolePlay Simulation sidebar feature. Managers configure an avatar
# customer, and the system launches a live Tavus video conversation that sales
# reps practice on.
#
# Get your Tavus API key: https://platform.tavus.io/api-keys
# Get your Replica ID:    https://platform.tavus.io/replicas
#
TAVUS_API_KEY=your_tavus_api_key_here
# Multi-account fallback (optional). Ordered "name:key" pairs — the FIRST entry
# serves every call; later entries are tried only when the one before hits a
# limit (max concurrent conversations, credits). The NAMES are bound to the
# per-account custom-replica registry in core/tavus_accounts.py (each account
# owns its own trained copies of the custom avatars), so to change which
# account serves, REORDER the entries — never rename them. When unset, the
# single TAVUS_API_KEY above is used alone (named "primary").
# TAVUS_ACCOUNTS=primary:key_of_primary_account,backup1:key_of_backup_account
# Default avatar replica used when no replica_id is passed in the form.
TAVUS_REPLICA_ID=your_tavus_replica_id_here
# OpenRouter model that powers the avatar's LLM (uses the existing OPENROUTER_API_KEY above).
TAVUS_DEFAULT_MODEL=google/gemini-2.0-flash-001
# ── Hindi roleplay latency knobs (English path is unaffected) ────────────────
# TAVUS_STT_ENGINE — Hindi speech-to-text engine. Unset = "tavus-whisper": most
#   ACCURATE Hindi, but BATCH (waits for the trainee to finish, then transcribes)
#   and is the single biggest source of Hindi reply lag. Set to a STREAMING engine
#   your Tavus plan supports to transcribe live and cut ~2-3s. Verify the exact
#   engine name in the Tavus dashboard/docs first — a wrong value makes Tavus
#   reject the persona and breaks all Hindi calls. Requires a server restart.
# TAVUS_STT_ENGINE=
# TAVUS_TURN_PATIENCE — how eagerly the Hindi avatar ends the trainee's turn.
#   Default "low" replies soonest; raise to "medium"/"high" if it interrupts.
# TAVUS_TURN_PATIENCE=low
# TAVUS_MAX_TOKENS — hard cap on the Hindi reply length (forwarded to the LLM via
#   Tavus extra_body). Default 200 fits 1-2 Hinglish sentences. LOWER = faster but
#   may truncate mid-sentence; HIGHER = longer, slower replies.
# TAVUS_MAX_TOKENS=200
# TAVUS_TEMPERATURE — optional avatar LLM temperature override (lower = more
#   on-script/deterministic). Unset = Tavus default.
# TAVUS_TEMPERATURE=0.7

