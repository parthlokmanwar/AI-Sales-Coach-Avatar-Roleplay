# ── Frontend env (Vite) ───────────────────────────────────────────────────────
# Copy to .env.local for local overrides. On Vercel, set these in
# Project → Settings → Environment Variables (NOT committed here).
#
# IMPORTANT: every VITE_* var is PUBLIC — it is baked into the JS bundle that
# ships to the browser. Anyone can read it via devtools. Never put a secret here
# that you wouldn't paste into a public webpage. Prefer proxying third-party APIs
# through the backend so their keys stay server-side.

# Public https URL of the backend.
#   DEV (local):  leave UNSET → relative /api + /ws ride the Vite dev proxy.
#   PROD (Vercel): set to your public backend URL, e.g. a cloudflared tunnel.
#                  Must be https:// (the browser blocks http/ws from an https page).
# VITE_API_URL=https://xxxx.trycloudflare.com

# Optional third-party keys used directly by the browser (see warning above).
# VITE_DEEPGRAM_API_KEY=
# VITE_SARVAM_API_KEY=
# VITE_USE_SARVAM=true
